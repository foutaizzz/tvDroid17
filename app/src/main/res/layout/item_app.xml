<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="@dimen/tile_row_height"
    android:paddingTop="12dp" android:clipChildren="false" android:clipToPadding="false">
    <FrameLayout android:id="@+id/card" android:layout_width="@dimen/tile_width"
        android:layout_height="@dimen/tile_height" android:layout_gravity="center_horizontal|top"
        android:background="@drawable/tile_bg" android:focusable="true" android:clickable="true">
        <ImageView android:id="@+id/banner" android:layout_width="match_parent"
            android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@null" />
        <ImageView android:id="@+id/icon" android:layout_width="48dp" android:layout_height="48dp"
            android:layout_gravity="center" android:visibility="gone" android:contentDescription="@null" />
        <TextView android:id="@+id/label" android:layout_width="0dp" android:layout_height="0dp"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>

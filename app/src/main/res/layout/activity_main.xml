<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="#FF000000">
    <com.tvdroid17.ArtworkBackdropView android:id="@+id/artwork"
        android:layout_width="match_parent" android:layout_height="match_parent" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipChildren="false" android:clipToPadding="false"
        android:orientation="vertical" android:paddingStart="@dimen/home_margin_horizontal"
        android:paddingEnd="@dimen/home_margin_horizontal" android:paddingTop="@dimen/home_margin_top">
        <LinearLayout android:id="@+id/topButtons" android:layout_width="match_parent"
            android:layout_height="36dp" android:orientation="horizontal" android:gravity="end|center_vertical"
            android:clipChildren="false" android:clipToPadding="false">
            <LinearLayout android:id="@+id/statusCapsule" android:layout_width="wrap_content" android:layout_height="32dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:clipChildren="false" android:clipToPadding="false"
                android:paddingStart="12dp" android:paddingEnd="8dp"
                android:background="@drawable/status_capsule">
                <TextClock android:id="@+id/clock" android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="HH:mm" android:format24Hour="HH:mm"
                    android:textColor="#F2FFFFFF" android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
                <FrameLayout android:id="@+id/btnSettings" style="@style/TopButton"
                    android:layout_width="28dp" android:layout_height="28dp"
                    android:focusableInTouchMode="true"
                    android:contentDescription="@string/settings"
                    android:nextFocusDown="@+id/grid">
                    <ImageView android:id="@+id/btnSettingsIcon"
                        android:layout_width="14dp" android:layout_height="14dp"
                        android:layout_gravity="center" android:src="@drawable/ic_controls_compact"
                        android:tint="#FFFFFFFF" android:importantForAccessibility="no" />
                </FrameLayout>
            </LinearLayout>
            <!-- IDs retained for the legacy input-popup fallback and network descriptions. -->
            <TextView android:id="@+id/btnInputs" style="@style/TopButton"
                android:visibility="gone"
                android:contentDescription="@string/inputs" android:drawableStart="@drawable/ic_input"
                android:nextFocusDown="@+id/grid" />
            <TextView android:id="@+id/btnWifi" style="@style/TopButton"
                android:visibility="gone"
                android:contentDescription="@string/wifi" android:drawableStart="@drawable/ic_wifi"
                android:nextFocusDown="@+id/grid" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:clipChildren="false" android:clipToPadding="false"
            android:layout_marginStart="-32dp" android:layout_marginEnd="-32dp"
            android:layout_weight="1" android:layout_marginTop="12dp">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/grid"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:paddingStart="@dimen/home_margin_horizontal" android:paddingEnd="@dimen/home_margin_horizontal"
                android:paddingBottom="40dp" android:clipToPadding="false"
                android:clipChildren="false" android:overScrollMode="never"
                android:scrollbars="none" android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>
    <FrameLayout android:id="@+id/artworkTarget" android:layout_width="380dp"
        android:layout_height="wrap_content" android:layout_marginTop="166dp"
        android:layout_marginStart="40dp" android:layout_marginEnd="40dp"
        android:focusable="true" android:clickable="true" android:visibility="gone">
        <LinearLayout android:id="@+id/artworkDetails" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:visibility="invisible">
        <TextView android:id="@+id/artworkGenres" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#EDFFFFFF"
            android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
            android:maxLines="2" android:ellipsize="end" android:lineSpacingExtra="2dp" />
        <com.tvdroid17.SummaryScrollView android:id="@+id/summaryScroll"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:scrollbars="vertical" android:overScrollMode="never" android:fadeScrollbars="false">
        <TextView android:id="@+id/artworkDescription" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp"
            android:textColor="#D9FFFFFF" android:fontFamily="sans-serif" android:includeFontPadding="false"
            android:lineSpacingExtra="1dp" />
        </com.tvdroid17.SummaryScrollView>
        <TextView android:id="@+id/artworkHint" android:layout_width="wrap_content"
            android:layout_height="34dp" android:layout_marginTop="20dp"
            android:paddingStart="32dp" android:paddingEnd="32dp" android:gravity="center"
            android:text="Regarder" android:drawableStart="@drawable/ic_play" android:drawablePadding="8dp"
            android:textColor="#FFFFFFFF" android:textSize="15sp" android:fontFamily="sans-serif-medium"
            android:maxLines="1" android:includeFontPadding="false"
            android:background="@drawable/watch_button" android:visibility="invisible" />
        </LinearLayout>
    </FrameLayout>
    <View android:id="@+id/startupCover" android:layout_width="match_parent"
        android:layout_height="match_parent" android:background="#FF000000"
        android:visibility="visible" android:clickable="true" android:focusable="false"
        android:importantForAccessibility="no" />
</FrameLayout>
